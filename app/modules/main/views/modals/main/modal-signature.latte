<div class="modal fade" id="modal-signature" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalSignatureLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title" id="modalSignatureLabel">{='signature'|translate}</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{='Close'|translate}"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2 alert-info">
          <div class="col g-2 col-sm-3 align-self-center text-center">
            <i class="fa fa-pencil-square-o fa-5x"></i>
          </div>
          <div class="col g-2 col-sm-9">
            <h5>{='confirm_signature_text'|translate}</h5>
          </div>
        </div>
        <div class="row">&nbsp;</div>
        <div class="row">
          <div class="form-group col-lg-12" style="padding-right: 5px;">
            <label for="signature-auth-code" class="form-label">{='Authenticator code'|translate}</label>
            <input type="text" maxlength="6" class="form-control text-center" id="signature-auth-code" autocomplete="one-time-code" pattern="\d{6}" inputmode="numeric" placeholder="000000">
            <div id="alert-signature"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default btn-sm" data-bs-dismiss="modal">
          <i class="fa fa-times-circle"></i> {='Cancel'|translate}
        </button>
        <button type="button" class="btn btn-primary btn-sm" id="btnSign" disabled>
          <i class="fa fa-check"></i> {='Sign'|translate}
        </button>
      </div>
    </div>
  </div>
</div>
