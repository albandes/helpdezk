<div class="modal fade" id="modal-authenticator" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalAuthenticatorLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title" id="modalAuthenticatorLabel">{='Authenticator'|translate}</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{='Close'|translate}"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2 alert-info">
          <div class="col g-2 col-sm-3 align-self-center text-center">
            <i class="fa fa-qrcode fa-2x"></i>
          </div>
          <div class="col g-2 col-sm-9">
            <h5>{='Scan the QRCode with your authenticator app'|translate}</h5>
          </div>
        </div>
				<div class="row g2">
				  <div class="col-sm-3">&nbsp;</div>
				  <div class="col-sm-7" id="authenticator-qrcode">
						<img id="qrcode-img"/>
					</div>
				</div>
				<div class="row g2">
					<label for="authenticator-code" class="col-form-label text-end">{='authenticator_code'|translate}:</label>
					<input type="hidden" name="code" id="secret" class="form-control form-control-sm" placeholder="{='authenticator_code'|translate}" />
					<input type="text" name="secret" id="authenticator-code" class="form-control form-control-sm" placeholder="{='authenticator_code'|translate}" />
				</div>
        <div class="row">&nbsp;</div>
        <div class="row">
          <div class="form-group col-lg-12" style="padding-right: 5px;">
            <div id="alert-authenticator"></div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default btn-sm" data-bs-dismiss="modal">
          <i class="fa fa-times-circle"></i> {='Cancel'|translate}
        </button>
        <button type="button" class="btn btn-primary btn-sm" disabled id="btnConfirmAuthenticator">
          <i class="fa fa-check"></i> {='Ok'|translate}
        </button>
      </div>
    </div>
  </div>
</div>
