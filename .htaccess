#for html, php
AddDefaultCharset UTF-8

#for css, js
AddType 'text/css; charset=UTF-8' css
AddType 'application/x-javascript; charset=UTF-8' js

#SEGURANÇA ADICIONAL
#Bloqueia acesso ao .env e arquivos ocultos (.git, .htaccess, etc.)
<FilesMatch "^\..*">
Order allow,deny
Deny from all
</FilesMatch>

#Protege arquivos de configuração comuns
<FilesMatch "(composer.json|composer.lock|package.json|yarn.lock|.gitignore|README.md)">
Order allow,deny
Deny from all
</FilesMatch>

RewriteEngine on

# E-mail Tracker
RewriteRule ^tracker/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)\.png tracker/tracker.php?id=$2&campaign=$1

# MVC
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteCond %{SCRIPT_FILENAME} !-d

RewriteCond %{REQUEST_URI} !^/api
RewriteCond %{REQUEST_URI} !^/tracker
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]